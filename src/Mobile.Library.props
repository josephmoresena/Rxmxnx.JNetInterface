<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

    <PropertyGroup>
        <TargetFrameworks>
            net7.0-android;
            net8.0-android;
            net9.0-android;
            net10.0-android;
            net11.0-android;
            $(TargetFrameworks)
        </TargetFrameworks>
        <OutputType>Library</OutputType>
        <CheckEolWorkloads>false</CheckEolWorkloads>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.EndsWith('android'))">
        <AndroidApplication>false</AndroidApplication>
        <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
        <AndroidUseManagedDesignTimeResourceGenerator>false</AndroidUseManagedDesignTimeResourceGenerator>
        <AndroidGenerateLayoutBindings>false</AndroidGenerateLayoutBindings>
        <AndroidUseLatestPlatformSdk>false</AndroidUseLatestPlatformSdk>
        <AndroidIncludeDebugSymbols>false</AndroidIncludeDebugSymbols>
        <AndroidUseDesignerAssembly>false</AndroidUseDesignerAssembly>
        <UseAndroidReferencePack Condition="'$(IsMobileLibrary)' == 'True' And '$(Version)' == ''">True</UseAndroidReferencePack>
        <UseAndroidReferencePack Condition="!$(AssemblyName.EndsWith('.Intermediate'))">True</UseAndroidReferencePack>
    </PropertyGroup>
    <PropertyGroup Condition="$(TargetFramework.EndsWith('android'))">
        <SupportedOSPlatformVersion Condition="!$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">21.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net11.0'))">24.0</SupportedOSPlatformVersion>
        <NoWarn Condition="'$(SupportedOSPlatformVersion)' == '21.0'">$(NoWarn);CA1418</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <Using Remove="Android.App"/>
        <Using Remove="Android.Widget"/>
        <Using Remove="Android.OS.Bundle"/>
    </ItemGroup>

</Project>
